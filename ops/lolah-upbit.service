[Unit]
Description=Lolah Upbit first-signal read-only monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lolah
Group=lolah
WorkingDirectory=/opt/lolah/app
Environment=NODE_ENV=production
EnvironmentFile=/etc/lolah/upbit.env
ExecStart=/usr/bin/npm run upbit:worker
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/lolah
MemoryMax=256M

[Install]
WantedBy=multi-user.target
